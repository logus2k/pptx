# Copy to .env (git-ignored) and fill in. Never commit .env.
SLIDES_ENV=dev
# the value proxy_server adds as X-Slides-Proxy-Secret (proxy_server/conf/secrets/slides.conf); empty = no check (dev only)
SLIDES_PROXY_SECRET=
# development only, without a secret: the address the app acts as
SLIDES_DEV_USER=
# Cortex service key (Cortex: Settings > API keys > New service key, application "slides")
SLIDES_CORTEX_SERVICE_KEY=
ANTHROPIC_API_KEY=
SLIDES_LOG_PSEUDONYM_KEY=
