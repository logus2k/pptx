{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/change_template",
 "title": "change_template",
 "description": "Put the whole deck on another template: every slide re-mapped onto its layouts and theme; content with no place is kept and reported. The person approves first.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "template"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "template": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "id"
   ],
   "description": "From list_templates.",
   "properties": {
    "kind": {
     "enum": [
      "admin",
      "asset"
     ]
    },
    "id": {
     "type": "string"
    }
   }
  }
 }
}
