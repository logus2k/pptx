{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/add_slide",
 "title": "add_slide",
 "description": "Insert ONE new slide from a layout and write what it says: content (title, subtitle, points) is put in the layout's places by the application; placeholders by idx only for a particular place. A slide for each point of an outline: one add_slide per point.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "layout"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "layout": {
   "type": "string",
   "description": "A layout name from list_layouts."
  },
  "position": {
   "type": "integer",
   "minimum": 0,
   "description": "Or its place counted from 0 (0 = first). Use after_slide_id or before_slide_id instead when you can. Left out (with no after/before): at the end."
  },
  "placeholders": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "description": "A particular placeholder by idx and its text (\\n between lines). For what the slide says, use content.",
    "properties": {
     "idx": {
      "type": "integer"
     },
     "type": {
      "type": "string"
     },
     "text": {
      "type": "string",
      "maxLength": 4000
     },
     "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "description": "One entry per paragraph (bullet): {\"text\", \"level\"}.",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "text": {
         "type": "string",
         "maxLength": 4000
        },
        "level": {
         "type": "integer",
         "minimum": 0,
         "maximum": 4,
         "description": "Bullet level, 0 = top."
        },
        "runs": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "object",
          "required": [
           "text"
          ],
          "additionalProperties": false,
          "properties": {
           "text": {
            "type": "string",
            "maxLength": 2000,
            "description": "\\n makes a line break inside the paragraph."
           },
           "bold": {
            "type": "boolean"
           },
           "italic": {
            "type": "boolean"
           },
           "theme_color": {
            "enum": [
             "text1",
             "text2",
             "accent1",
             "accent2",
             "accent3",
             "accent4",
             "accent5",
             "accent6"
            ]
           }
          }
         },
         "x-hidden": true
        },
        "alignment": {
         "enum": [
          "left",
          "center",
          "right",
          "justify"
         ],
         "x-hidden": true
        }
       },
       "anyOf": [
        {
         "required": [
          "runs"
         ]
        },
        {
         "required": [
          "text"
         ]
        }
       ]
      },
      "x-hidden": true
     }
    }
   }
  },
  "after_slide_id": {
   "type": "integer",
   "description": "Put it right after this slide (its number or ID). The simplest way to place it."
  },
  "before_slide_id": {
   "type": "integer",
   "description": "Put it right before this slide (its number or ID)."
  },
  "content": {
   "type": "object",
   "additionalProperties": false,
   "description": "What the slide says; the application puts each part where the layout has its place (the heading, the subtitle, each point in a box of its own with the box's number or column heading, or every point in one list) and removes the places left empty. Only text from the request or from what you found: never filler.",
   "properties": {
    "title": {
     "type": "string",
     "maxLength": 300
    },
    "subtitle": {
     "type": "string",
     "maxLength": 300
    },
    "points": {
     "type": "array",
     "maxItems": 30,
     "description": "The slide's points, in order: a text, or {heading, text} for a point with a heading of its own (a column, a phase).",
     "items": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 1000
       },
       {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "heading": {
          "type": "string",
          "maxLength": 200
         },
         "text": {
          "type": "string",
          "maxLength": 1000
         }
        }
       }
      ]
     }
    },
    "sources": {
     "type": "array",
     "maxItems": 10,
     "items": {
      "type": "string",
      "maxLength": 300
     },
     "description": "The titles of the knowledge-base documents its text comes from: the application writes their citations in the slide's notes."
    }
   }
  }
 }
}
