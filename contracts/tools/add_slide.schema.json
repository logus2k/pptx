{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/add_slide",
 "title": "add_slide",
 "description": "Insert ONE new slide from a layout and write what it says: content (title, subtitle, points, or a chart or diagram) is put in the layout's places by the application; placeholders by idx only for a particular place. A slide for each point of an outline: one add_slide per point.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "layout"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "layout": {
   "type": "string",
   "description": "A layout name from list_layouts."
  },
  "position": {
   "type": "integer",
   "minimum": 0,
   "description": "Or its place counted from 0 (0 = first). Use after_slide_id or before_slide_id instead when you can. Left out (with no after/before): at the end."
  },
  "placeholders": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "description": "A particular placeholder by idx and its text (\\n between lines). For what the slide says, use content.",
    "properties": {
     "idx": {
      "type": "integer"
     },
     "type": {
      "type": "string"
     },
     "text": {
      "type": "string",
      "maxLength": 4000
     },
     "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "description": "One entry per paragraph (bullet): {\"text\", \"level\"}.",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "text": {
         "type": "string",
         "maxLength": 4000
        },
        "level": {
         "type": "integer",
         "minimum": 0,
         "maximum": 4,
         "description": "Bullet level, 0 = top."
        },
        "runs": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "object",
          "required": [
           "text"
          ],
          "additionalProperties": false,
          "properties": {
           "text": {
            "type": "string",
            "maxLength": 2000,
            "description": "\\n makes a line break inside the paragraph."
           },
           "bold": {
            "type": "boolean"
           },
           "italic": {
            "type": "boolean"
           },
           "theme_color": {
            "enum": [
             "text1",
             "text2",
             "accent1",
             "accent2",
             "accent3",
             "accent4",
             "accent5",
             "accent6"
            ]
           }
          }
         },
         "x-hidden": true
        },
        "alignment": {
         "enum": [
          "left",
          "center",
          "right",
          "justify"
         ],
         "x-hidden": true
        }
       },
       "anyOf": [
        {
         "required": [
          "runs"
         ]
        },
        {
         "required": [
          "text"
         ]
        }
       ]
      },
      "x-hidden": true
     }
    }
   }
  },
  "after_slide_id": {
   "type": "integer",
   "description": "Put it right after this slide (its number or ID). The simplest way to place it."
  },
  "before_slide_id": {
   "type": "integer",
   "description": "Put it right before this slide (its number or ID)."
  },
  "content": {
   "type": "object",
   "additionalProperties": false,
   "description": "What the slide says; the application places each part in the layout. Only text from the request or a source, never filler.",
   "properties": {
    "title": {
     "type": "string",
     "maxLength": 300
    },
    "subtitle": {
     "type": "string",
     "maxLength": 300
    },
    "points": {
     "type": "array",
     "maxItems": 30,
     "description": "Its points, in order: short lines in your words, or {heading, text} (a column, a phase).",
     "items": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 200
       },
       {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "heading": {
          "type": "string",
          "maxLength": 200
         },
         "text": {
          "type": "string",
          "maxLength": 300
         }
        }
       }
      ]
     }
    },
    "sources": {
     "type": "array",
     "maxItems": 10,
     "items": {
      "type": "string",
      "maxLength": 300
     },
     "description": "Titles of the KB documents it comes from (cited in the notes)."
    },
    "chart": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "categories",
      "series"
     ],
     "description": "A chart in the slide's body, under its title (instead of points).",
     "properties": {
      "kind": {
       "enum": [
        "column",
        "bar",
        "line",
        "pie"
       ],
       "description": "column, bar (horizontal), line, pie (one series)."
      },
      "categories": {
       "type": "array",
       "minItems": 1,
       "maxItems": 50,
       "items": {
        "type": "string",
        "maxLength": 100
       },
       "description": "The bars, points or slices, in order."
      },
      "series": {
       "type": "array",
       "minItems": 1,
       "maxItems": 8,
       "description": "Each: a name and one number per category.",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "name",
         "values"
        ],
        "properties": {
         "name": {
          "type": "string",
          "maxLength": 100
         },
         "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
           "type": "number"
          }
         }
        }
       }
      },
      "number_format": {
       "type": "string",
       "maxLength": 40,
       "description": "As PowerPoint writes it: 0, 0.0, 0%, #,##0 €."
      }
     }
    },
    "diagram": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "nodes"
     ],
     "description": "A diagram in the slide's body, under its title (instead of points).",
     "properties": {
      "nodes": {
       "type": "array",
       "minItems": 2,
       "maxItems": 20,
       "description": "The boxes, numbered from 0.",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "text"
        ],
        "properties": {
         "text": {
          "type": "string",
          "maxLength": 80,
          "description": "A short label."
         }
        }
       }
      },
      "edges": {
       "type": "array",
       "maxItems": 40,
       "description": "Arrows from box n to box m. Left out: each box to the next (a process).",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "from",
         "to"
        ],
        "properties": {
         "from": {
          "type": "integer",
          "minimum": 0
         },
         "to": {
          "type": "integer",
          "minimum": 0
         }
        }
       }
      },
      "direction": {
       "enum": [
        "right",
        "down"
       ],
       "description": "right: a flow; down: a hierarchy. Left out: right."
      }
     }
    }
   }
  }
 }
}
