{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/duplicate_shape",
 "title": "duplicate_shape",
 "description": "Copy a shape of a diagram - a box, a label, a connector - with all its styling (outline, fill, font), to add one like it; optionally with new text. The result gives the copy's shape ID.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "slide_id",
  "shape_id"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "slide_id": {
   "type": "integer",
   "description": "The slide: its number in the deck (1 = first, as the deck map and the person say it) or its ID."
  },
  "shape_id": {
   "type": "integer",
   "description": "The shape to copy, from the deck map."
  },
  "box": {
   "type": "object",
   "required": [
    "x",
    "y"
   ],
   "additionalProperties": false,
   "description": "Where the copy goes, as fractions (0 to 1) of the slide's width and height; w and h left out: the original's size. Left out: just right of the original.",
   "properties": {
    "x": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "y": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "w": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "h": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  },
  "paragraphs": {
   "type": "array",
   "minItems": 1,
   "maxItems": 40,
   "description": "The copy's text, one entry per paragraph: {\"text\": \"...\"}. Left out: the original's text.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 4000
     },
     "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Bullet level, 0 = top."
     },
     "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "text"
       ],
       "additionalProperties": false,
       "properties": {
        "text": {
         "type": "string",
         "maxLength": 2000,
         "description": "\\n makes a line break inside the paragraph."
        },
        "bold": {
         "type": "boolean"
        },
        "italic": {
         "type": "boolean"
        },
        "theme_color": {
         "enum": [
          "text1",
          "text2",
          "accent1",
          "accent2",
          "accent3",
          "accent4",
          "accent5",
          "accent6"
         ]
        }
       }
      },
      "x-hidden": true
     },
     "alignment": {
      "enum": [
       "left",
       "center",
       "right",
       "justify"
      ],
      "x-hidden": true
     }
    },
    "anyOf": [
     {
      "required": [
       "runs"
      ]
     },
     {
      "required": [
       "text"
      ]
     }
    ]
   }
  }
 }
}
