{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/update_text",
 "title": "update_text",
 "description": "Replace all the text of one shape (a placeholder, text box or shape) with the given paragraphs. The shape keeps its own formatting unless a run says otherwise.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "slide_id",
  "shape_id",
  "paragraphs"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "slide_id": {
   "type": "integer",
   "description": "The slide: its number in the deck (1 = first, as the deck map and the person say it) or its ID."
  },
  "shape_id": {
   "type": "integer",
   "description": "From the deck map."
  },
  "paragraphs": {
   "type": "array",
   "minItems": 1,
   "maxItems": 40,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Bullet level, 0 = top."
     },
     "alignment": {
      "enum": [
       "left",
       "center",
       "right",
       "justify"
      ]
     },
     "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "text"
       ],
       "additionalProperties": false,
       "properties": {
        "text": {
         "type": "string",
         "maxLength": 2000,
         "description": "\\n makes a line break inside the paragraph."
        },
        "bold": {
         "type": "boolean"
        },
        "italic": {
         "type": "boolean"
        },
        "theme_color": {
         "enum": [
          "text1",
          "text2",
          "accent1",
          "accent2",
          "accent3",
          "accent4",
          "accent5",
          "accent6"
         ]
        }
       }
      }
     },
     "text": {
      "type": "string",
      "maxLength": 4000,
      "description": "Plain text for the whole paragraph (instead of runs)."
     }
    },
    "anyOf": [
     {
      "required": [
       "runs"
      ]
     },
     {
      "required": [
       "text"
      ]
     }
    ]
   },
   "description": "One entry per paragraph: {\"text\": \"...\"} for plain text, or {\"runs\": [...]} when parts need formatting."
  }
 }
}
