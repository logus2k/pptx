{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/undo",
 "title": "undo",
 "description": "Undo the last accepted changes of a deck (each step is a new version; nothing is lost).",
 "type": "object",
 "additionalProperties": false,
 "required": [],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "steps": {
   "type": "integer",
   "minimum": 1,
   "maximum": 20
  }
 }
}
