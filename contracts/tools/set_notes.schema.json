{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/set_notes",
 "title": "set_notes",
 "description": "Replace a slide's speaker notes.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "slide_id",
  "text"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "slide_id": {
   "type": "integer",
   "description": "The slide: its number in the deck (1 = first, as the deck map and the person say it) or its ID."
  },
  "text": {
   "type": "string",
   "maxLength": 20000
  }
 }
}
