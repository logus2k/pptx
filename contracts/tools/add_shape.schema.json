{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/add_shape",
 "title": "add_shape",
 "description": "Add a text box or a simple shape inside the slide. In the theme's style: for a box like a diagram's own, use duplicate_shape.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "slide_id",
  "kind",
  "box"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "slide_id": {
   "type": "integer",
   "description": "The slide: its number in the deck (1 = first, as the deck map and the person say it) or its ID."
  },
  "kind": {
   "enum": [
    "text_box",
    "rectangle",
    "rounded_rectangle",
    "oval"
   ]
  },
  "box": {
   "type": "object",
   "required": [
    "x",
    "y",
    "w",
    "h"
   ],
   "additionalProperties": false,
   "description": "Position and size as fractions (0 to 1) of the slide's width and height.",
   "properties": {
    "x": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "y": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "w": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "h": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  },
  "paragraphs": {
   "type": "array",
   "minItems": 1,
   "maxItems": 40,
   "description": "One entry per paragraph (bullet): {\"text\", \"level\"}.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 4000
     },
     "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Bullet level, 0 = top."
     },
     "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "text"
       ],
       "additionalProperties": false,
       "properties": {
        "text": {
         "type": "string",
         "maxLength": 2000,
         "description": "\\n makes a line break inside the paragraph."
        },
        "bold": {
         "type": "boolean"
        },
        "italic": {
         "type": "boolean"
        },
        "theme_color": {
         "enum": [
          "text1",
          "text2",
          "accent1",
          "accent2",
          "accent3",
          "accent4",
          "accent5",
          "accent6"
         ]
        }
       }
      },
      "x-hidden": true
     },
     "alignment": {
      "enum": [
       "left",
       "center",
       "right",
       "justify"
      ],
      "x-hidden": true
     }
    },
    "anyOf": [
     {
      "required": [
       "runs"
      ]
     },
     {
      "required": [
       "text"
      ]
     }
    ]
   }
  }
 }
}
