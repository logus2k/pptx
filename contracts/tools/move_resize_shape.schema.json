{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/move_resize_shape",
 "title": "move_resize_shape",
 "description": "Move or resize a shape; the box must lie within the slide.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "slide_id",
  "shape_id",
  "box"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "slide_id": {
   "type": "integer",
   "description": "The slide: its number in the deck (1 = first, as the deck map and the person say it) or its ID."
  },
  "shape_id": {
   "type": "integer",
   "description": "From the deck map."
  },
  "box": {
   "type": "object",
   "required": [
    "x",
    "y",
    "w",
    "h"
   ],
   "additionalProperties": false,
   "description": "Position and size as fractions (0 to 1) of the slide's width and height.",
   "properties": {
    "x": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "y": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "w": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "h": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  }
 }
}
