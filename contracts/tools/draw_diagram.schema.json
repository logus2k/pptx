{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/draw_diagram",
 "title": "draw_diagram",
 "description": "Draw a diagram (a process, a flow, an organisation): boxes and arrows, laid out in steps and styled like the deck's diagrams.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "slide_id",
  "nodes"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "slide_id": {
   "type": "integer",
   "description": "The slide's number or ID."
  },
  "nodes": {
   "type": "array",
   "minItems": 2,
   "maxItems": 20,
   "description": "The boxes, numbered from 0.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text"
    ],
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 80,
      "description": "A short label."
     }
    }
   }
  },
  "edges": {
   "type": "array",
   "maxItems": 40,
   "description": "Arrows from box n to box m. Left out: each box to the next (a process).",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "from",
     "to"
    ],
    "properties": {
     "from": {
      "type": "integer",
      "minimum": 0
     },
     "to": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "direction": {
   "enum": [
    "right",
    "down"
   ],
   "description": "right: a flow; down: a hierarchy. Left out: right."
  },
  "like_shape_id": {
   "type": "integer",
   "description": "A box on this slide to look like. Left out: the deck's nearest diagram."
  },
  "box": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "x",
    "y",
    "w",
    "h"
   ],
   "description": "The area, fractions of the slide. Left out: under the title.",
   "properties": {
    "x": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "y": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "w": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "h": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  }
 }
}
