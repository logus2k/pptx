{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/add_chart",
 "title": "add_chart",
 "description": "Put a native PowerPoint chart (editable in PowerPoint, its data in the file) on a slide, from data the person gives or a source says: column, bar, line or pie.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "slide_id",
  "kind",
  "categories",
  "series"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "slide_id": {
   "type": "integer",
   "description": "The slide's number or ID."
  },
  "kind": {
   "enum": [
    "column",
    "bar",
    "line",
    "pie"
   ],
   "description": "column: vertical bars; bar: horizontal bars; line; pie (one series)."
  },
  "title": {
   "type": "string",
   "maxLength": 200
  },
  "categories": {
   "type": "array",
   "minItems": 1,
   "maxItems": 50,
   "items": {
    "type": "string",
    "maxLength": 100
   },
   "description": "The categories (the bars, points or slices), in order."
  },
  "series": {
   "type": "array",
   "minItems": 1,
   "maxItems": 8,
   "description": "One per data series (a pie has one): its name and one number per category.",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "values"
    ],
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 100
     },
     "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
       "type": "number"
      }
     }
    }
   }
  },
  "number_format": {
   "type": "string",
   "maxLength": 40,
   "description": "How values are shown, as PowerPoint writes it: 0, 0.0, 0%, #,##0 €. Left out: as given."
  },
  "box": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "x",
    "y",
    "w",
    "h"
   ],
   "description": "Where, in fractions of the slide (0-1). Left out: the slide's chart place, else the space under its title.",
   "properties": {
    "x": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "y": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "w": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "h": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  }
 }
}
