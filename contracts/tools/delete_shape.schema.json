{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tools/delete_shape",
 "title": "delete_shape",
 "description": "Delete a shape from a slide.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "slide_id",
  "shape_id"
 ],
 "properties": {
  "deck_id": {
   "type": "string",
   "description": "Left out: the active deck."
  },
  "slide_id": {
   "type": "integer",
   "description": "The slide: its number in the deck (1 = first, as the deck map and the person say it) or its ID."
  },
  "shape_id": {
   "type": "integer",
   "description": "From the deck map."
  }
 }
}
