{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "storage/descriptions.schema.json",
 "title": "DATA_DIR/projects/<pid>/descriptions.json: what each picture in the project's decks shows, by the vision model (spec IM-4)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "images"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "images": {
   "type": "object",
   "description": "image sha256 -> its description",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "text",
     "at"
    ],
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 400
     },
     "at": {
      "type": "string"
     }
    }
   }
  }
 }
}
