{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "storage/generation.schema.json",
 "title": "DATA_DIR/projects/<pid>/generations/<id>.json: a deck being generated from a source (spec NL-12): the request, the reading's progress, the outline the person reviews, the deck it made",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "id",
  "created_by",
  "created_at",
  "updated_at",
  "status",
  "request"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "id": {
   "type": "string"
  },
  "created_by": {
   "type": "string"
  },
  "created_at": {
   "type": "string"
  },
  "updated_at": {
   "type": "string"
  },
  "status": {
   "enum": [
    "reading",
    "ready",
    "failed",
    "built"
   ]
  },
  "progress": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "stage": {
     "type": "string"
    },
    "done": {
     "type": "integer"
    },
    "total": {
     "type": "integer"
    }
   }
  },
  "request": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "source"
   ],
   "properties": {
    "kind": {
     "enum": [
      "corporate",
      "training"
     ]
    },
    "source": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind"
     ],
     "properties": {
      "kind": {
       "enum": [
        "kb_topic",
        "kb_document",
        "document"
       ]
      },
      "query": {
       "type": "string",
       "maxLength": 500
      },
      "domain": {
       "type": "string",
       "maxLength": 200
      },
      "path": {
       "type": "string",
       "maxLength": 1000
      },
      "asset_id": {
       "type": "string",
       "maxLength": 64
      }
     }
    },
    "slides": {
     "type": "integer",
     "minimum": 1,
     "maximum": 40
    },
    "focus": {
     "type": "string",
     "maxLength": 1000
    },
    "audience": {
     "type": "string",
     "maxLength": 300
    },
    "language": {
     "enum": [
      "pt",
      "en"
     ]
    },
    "target": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind"
     ],
     "properties": {
      "kind": {
       "enum": [
        "new",
        "deck"
       ]
      },
      "deck_id": {
       "type": "string"
      },
      "template": {
       "type": "object"
      }
     }
    },
    "conversation_id": {
     "type": "string"
    }
   }
  },
  "outline": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "kind",
    "slides"
   ],
   "properties": {
    "title": {
     "type": "string",
     "maxLength": 300
    },
    "kind": {
     "enum": [
      "corporate",
      "training"
     ]
    },
    "slides": {
     "type": "array",
     "maxItems": 60,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "role",
       "title",
       "points"
      ],
      "properties": {
       "role": {
        "enum": [
         "content",
         "objectives",
         "section",
         "questions",
         "summary"
        ]
       },
       "title": {
        "type": "string",
        "maxLength": 300
       },
       "points": {
        "type": "array",
        "maxItems": 30,
        "items": {
         "type": "string",
         "maxLength": 1000
        }
       },
       "notes": {
        "type": "string",
        "maxLength": 6000
       },
       "sources": {
        "type": "array",
        "maxItems": 20,
        "items": {
         "type": "string",
         "maxLength": 500
        }
       },
       "design": {
        "type": "object",
        "description": "How the slide shows its content: the Artist's proposal (storage/design.schema.json), checked by agent/artist.py"
       },
       "task": {
        "type": "string",
        "maxLength": 1000,
        "description": "What the slide must achieve, as the Planner set it; the Writer and the Artist work to it"
       },
       "goal": {
        "type": "integer",
        "minimum": 0,
        "maximum": 8,
        "description": "The number of the goal the slide serves (1 = the first); 0 for objectives, sections, questions and summary"
       },
       "review": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "verdict",
         "issues"
        ],
        "description": "The Critic's last word on the slide as rendered (agent/critic.py): each issue what is wrong and how to fix it",
        "properties": {
         "verdict": {
          "enum": [
           "good",
           "revise"
          ]
         },
         "issues": {
          "type": "array",
          "maxItems": 20,
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "kind",
            "what",
            "fix"
           ],
           "properties": {
            "kind": {
             "type": "string",
             "maxLength": 40
            },
            "what": {
             "type": "string",
             "maxLength": 1000
            },
            "fix": {
             "type": "string",
             "maxLength": 1000
            },
            "severity": {
             "enum": [
              "must",
              "could"
             ],
             "description": "must: the audience would misunderstand, strain or think it unfinished; could: a suggestion"
            }
           }
          }
         }
        }
       }
      }
     }
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "document": {
        "type": "string"
       },
       "link": {
        "type": "string"
       }
      }
     }
    },
    "read": {
     "type": "object"
    },
    "goals": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "type": "string",
      "maxLength": 500
     },
     "description": "The Planner's goals: what the audience will know or be able to do at the end (agent/outline.plan)"
    }
   }
  },
  "error": {
   "type": "string",
   "maxLength": 1000
  },
  "deck_id": {
   "type": "string"
  },
  "slide_ids": {
   "type": "array",
   "items": {
    "type": "integer"
   }
  }
 }
}
