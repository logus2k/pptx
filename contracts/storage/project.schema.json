{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storage/project.schema.json",
  "title": "DATA_DIR/projects/<id>/project.json (technical design section 4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description", "owner", "members", "settings", "instructions", "archived", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 8, "maxLength": 32 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "owner": { "type": "string", "minLength": 3 },
    "members": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["email", "role"],
        "properties": { "email": { "type": "string", "minLength": 3 }, "role": { "enum": ["owner", "editor", "viewer"] } }
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["default_template", "language", "kb_domains", "model"],
      "properties": {
        "default_template": { "$ref": "#/$defs/template_ref" },
        "language": { "enum": ["pt", "en"] },
        "kb_domains": { "type": "array", "items": { "type": "string" } },
        "model": { "type": ["string", "null"] }
      }
    },
    "instructions": { "type": "string", "maxLength": 20000 },
    "archived": { "type": "boolean" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "$defs": {
    "template_ref": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "description": "Where a template comes from: an administrator template (templates.json id) or one of the project's assets.",
      "properties": { "kind": { "enum": ["admin", "asset"] }, "id": { "type": "string", "minLength": 1 } }
    }
  }
}
